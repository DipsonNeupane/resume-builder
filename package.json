{
  "name": "resumestride",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run seo:generate && tsc --noEmit && vite build",
    "test": "playwright test",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:db": "node scripts/test-database.mjs",
    "build:extension": "tsc -p apps/extension/tsconfig.json",
    "test:extension": "npm run build:extension && playwright test --config playwright.extension.config.ts",
    "benchmark:tailoring": "node --import tsx scripts/benchmark-tailoring-costs.ts",
    "test:server": "node --import tsx --test tests/server/*.test.ts tests/billing/*.test.ts",
    "check:server": "tsc -p tsconfig.server.json",
    "test:db:concurrency": "node scripts/test-database-concurrency.mjs",
    "test:paid": "playwright test --config playwright.paid.config.ts",
    "check:hosted-isolation": "node scripts/check-hosted-isolation.mjs",
    "package:extension": "npm run build:extension && node scripts/package-extension.mjs",
    "check:extension-package": "node scripts/check-extension-package.mjs && node --test scripts/tests/extension-package.test.mjs",
    "resources:generate": "node --import tsx scripts/render-resources.ts",
    "tools:generate": "node --import tsx scripts/render-tools.ts",
    "seo:generate": "npm run resources:generate && npm run tools:generate && node --import tsx scripts/generate-seo.ts",
    "test:tools": "node --import tsx --test tests/tools-analysis.test.ts && playwright test tests/tools.spec.ts",
    "test:seo": "node --import tsx scripts/render-resources.ts --check && node --import tsx scripts/render-tools.ts --check && node --import tsx scripts/generate-seo.ts --check && node --import tsx --test tests/server/seo.test.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "5.4.296",
    "puppeteer-core": "^25.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgtap": "^0.0.9",
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
