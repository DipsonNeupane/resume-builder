{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "server",
    "api",
    "tests/server",
    "tests/billing",
    "middleware.ts",
    "vite.config.ts",
    "scripts/generate-seo.ts"
  ]
}
