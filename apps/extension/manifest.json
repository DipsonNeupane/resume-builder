{
  "manifest_version": 3,
  "name": "ResumeStride Job Capture (Development)",
  "version": "0.2.1",
  "description": "Save an external job to ResumeStride, with job details added when safely available.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save job to ResumeStride",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://resumestride.com/*",
    "http://localhost:5173/*",
    "http://localhost:5183/*",
    "http://localhost:5185/*",
    "http://127.0.0.1:5173/*",
    "http://127.0.0.1:5183/*",
    "http://127.0.0.1:5185/*"
  ],
  "background": {
    "service_worker": "dist/background/worker.js",
    "type": "module"
  },
  "minimum_chrome_version": "120",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
