# Public project configuration only. Copy to .env.local (ignored by Git).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never put a service-role key, database password, Stripe secret, or AI key in VITE_*.

# Server-only launch configuration. Leave gates off until hosted acceptance.
BILLING_ENABLED=false
AI_ENABLED=false
APP_ORIGIN=https://resumestride.com
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_PASS_PRICE_ID=
STRIPE_MODE=test
# Optional recurring US$19.99/30-day subscription — a SEPARATE gate from
# BILLING_ENABLED above (see server/billing/stripe.ts's recurringConfig).
# Leave BILLING_RECURRING_ENABLED off; the one-time pass above stays the
# default purchase either way. STRIPE_RECURRING_PRICE_ID must be a
# different price than STRIPE_PASS_PRICE_ID. Cancellation of an existing
# subscription (api/cancel-subscription.ts) does not depend on either of
# these — it stays available even while new recurring sales are paused.
BILLING_RECURRING_ENABLED=false
STRIPE_RECURRING_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_TEMPLATE_PRICE_MAP={}
SUBSCRIPTION_OFFERS_ENABLED=false
RESEND_API_KEY=
BILLING_EMAIL_FROM=
NOTICE_DISPATCH_SECRET=
OPENAI_API_KEY=
TECHMAP_API_KEY=
# UI gate is public; it grants no entitlement or permission.
VITE_BILLING_UI_ENABLED=false
EXPORTS_ENABLED=false
VITE_PAID_FEATURES_UI_ENABLED=false

# Default false (see docs/FREE_SIGNUP_RELEASE.md). VITE_CLOUD_STORAGE_ENABLED
# turns on saving the resume itself to Supabase (useCloudResume). Leave false
# to let people sign in without any resume content ever leaving the browser.
# There is no first-party browser Print/PDF action to gate: the only
# supported PDF download is the authenticated, server-generated one
# (GeneratedPdfControls -> /api/export-pdf), which already requires sign-in.
VITE_CLOUD_STORAGE_ENABLED=false

# Optional operational switch: false disables new extension capture-save requests.
# Existing saved jobs, ordinary app saves, versions and entitlement checks are unchanged.
EXTENSION_CAPTURE_ENABLED=true

# Structured server diagnostics: info (default), warn, error, off.
# Fixed categories/timing only; never enable raw request or exception logging.
# Keep info for complete request-rate denominators. See docs/OBSERVABILITY.md.
DIAGNOSTICS_LEVEL=info
